#include <stdio.h>

int main() {
    int rows, cols;
    int a[100][100], b[100][100], sum[100][100];

    printf("Enter the number of rows (1 to 100): ");
    scanf("%d", &rows);

    printf("Enter the number of columns (1 to 100): ");
    scanf("%d", &cols);

    if (rows <= 0 || rows > 100 || cols <= 0 || cols > 100) {
        printf("Invalid dimensions. Please enter values between 1 and 100.\n");
        return 1;
    }

    printf("\nEnter elements of Matrix A:\n");
    for (int i = 0; i < rows; i++) {
        for (int j = 0; j < cols; j++) {
            printf("a[%d][%d]: ", i, j);
            scanf("%d", &a[i][j]);
        }
    }

    printf("\nEnter elements of Matrix B:\n");
    for (int i = 0; i < rows; i++) {
        for (int j = 0; j < cols; j++) {
            printf("b[%d][%d]: ", i, j);
            scanf("%d", &b[i][j]);
        }
    }

    for (int i = 0; i < rows; i++) {
        for (int j = 0; j < cols; j++) {
            sum[i][j] = a[i][j] + b[i][j];
        }
    }

    printf("\nResultant Matrix (A + B):\n");
    for (int i = 0; i < rows; i++) {
        for (int j = 0; j < cols; j++) {
            printf("%d\t", sum[i][j]);
        }
        printf("\n");
    }

    return 0;
}

