
#include <stdio.h>

int findNearest(int *dist, int n) {
    int min = *dist i;
    for (int i = 1; i < n; i++) {
        if (*(dist + i) < min) {
            min = *(dist + i);
        }
    }
    return min;
}

int main() {
    int dist[5];
    int n, min;
    
    printf("Enter number of sensors (1-5): ");
    scanf("%d", &n);
    
    if (n < 1 || n > 5) {
        printf("Invalid number of sensors!\n");
        return 1;
    }
    
    printf("Enter sensor readings (in cm): \n");
    for (int i = 0; i < n; i++) {
        printf("Sensor %d: ", i + 1);
        scanf("%d", &dist[i]);
    }
    
    min = findNearest(dist, n);
    printf("\nThe nearest sensor distance is: %d cm\n", min);
    
    if (min < 20) {
        printf("WARNING: Obstacle too close!\n");
    } else {
        printf("Path is clear\n");
    }
    
    return 0;
}
